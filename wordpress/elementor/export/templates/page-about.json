                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p>Every job starts with a request. You tell us what needs moving, where it is and where it is going. JMT reviews the details, contacts you with a quote and availability, and confirms the service with you before anything is booked.</p>",
                    "text_color": "#4a5571",
                    "typography_typography": "custom",
