# Copy to .env.local for development. Never commit real values.
# With none of these set, `npm run dev` uses the DEVELOPMENT adapters:
# local JSON store, local photo files and SIMULATED email in .data/.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "production" only on the approved live site. Anything else = staging (noindex, placeholders visible).
NEXT_PUBLIC_SITE_ENV=staging
# Optional GA4 measurement ID (G-XXXXXXX). Only non-personal events are sent.
# GA stays off until the client-approved privacy policy is published
# (pendingContent.privacyPolicy = false). Consent Mode v2: ad signals denied,
# visitors can opt out on the privacy page.
NEXT_PUBLIC_GA4_ID=

# --- Supabase (lead database + private photo bucket) ---
# Also read at BUILD time: the Content-Security-Policy allows browser photo
# uploads to this origin, so set it before `next build`.
SUPABASE_URL=
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=quote-photos

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Verified sender on a JMT-controlled domain.
MAIL_FROM="JMT Enterprise <requests@jmtenterprise.net>"
# Comma-separated. Use a designated TEST inbox until the launch smoke test.
LEAD_NOTIFICATION_TO=support@jmtenterprise.net
CUSTOMER_REPLY_TO=support@jmtenterprise.net

# --- Secrets (generate with: openssl rand -base64 32) ---
UPLOAD_TOKEN_SECRET=
CRON_SECRET=

# --- Bot protection (Cloudflare Turnstile, free). Off until both are set. ---
# Set both before `next build` (the site key is built into the page and the CSP).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Shared rate limiting (Upstash Redis REST). Without it, limits are per server instance. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional tuning ---
# Customer receipts per email address per 24h (stops the form being used to email strangers).
MAX_RECEIPTS_PER_RECIPIENT_PER_DAY=3
PHOTO_LINK_TTL_SECONDS=604800
MIN_FORM_SECONDS=4

# --- Development only ---
# ALLOW_DEV_ADAPTERS=true    # lets `next start` use dev adapters locally; never set in production
# DEV_MAIL_FAILURE=transient # or "permanent": simulate email outages
# DEV_STORE_FAILURE=true     # simulate a database failure on submit
